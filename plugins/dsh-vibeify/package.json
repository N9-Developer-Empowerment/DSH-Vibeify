{
  "name": "dsh-vibeify",
  "version": "0.7.0",
  "description": "A VIBE-customizable DeepSeek Harness bundle where DeepSeek executes eligible work under a ChatGPT-authenticated Codex lead.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    ".codex-plugin/plugin.json",
    "assets/",
    "client.js",
    "codex-capability.js",
    "codex-settings.js",
    "cordis.patch.yml",
    "delegation-contract.js",
    "index.js",
    "model-routing-policy.json",
    "routing-policy.js",
    "skills/"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check codex-capability.js && node --check codex-settings.js && node --check delegation-contract.js && node --check routing-policy.js",
    "test": "node --test *.test.js"
  },
  "keywords": [
    "codex",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "vibe"
  ],
  "author": "Errol Elliott",
  "contributors": [
    "Daniela Elliott"
  ],
  "homepage": "https://dsh-vibeify.ezzye.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N9-Developer-Empowerment/DSH-Vibeify.git"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@openai/codex": "0.147.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=22"
  }
}
