{
  "name": "dsh-vibeify",
  "version": "0.6.0",
  "description": "A VIBE-customizable DeepSeek Harness bundle with ChatGPT-authenticated Codex as lead and optional DeepSeek workers.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    ".codex-plugin/plugin.json",
    "assets/",
    "client.js",
    "cordis.patch.yml",
    "index.js",
    "model-routing-policy.json",
    "routing-policy.js",
    "skills/"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test routing-policy.test.js"
  },
  "keywords": [
    "codex",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "vibe"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@openai/codex": "0.147.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.1.1-rc.2"
  },
  "engines": {
    "node": ">=22"
  }
}
